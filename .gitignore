# =============================================================================
# Python - Sistema de recomendacion de restaurantes (Neo4j AuraDB)
# =============================================================================
# Buenas practicas para proyectos Python en GitHub.
# https://gitignore.readthedocs.io/en/latest/
# =============================================================================


# -----------------------------------------------------------------------------
# Entornos virtuales
# -----------------------------------------------------------------------------
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
.python-version


# -----------------------------------------------------------------------------
# Variables de entorno y secretos
# -----------------------------------------------------------------------------
# Nunca subir credenciales de Neo4j AuraDB ni API keys
.env
.env.*
!.env.example
*.env


# -----------------------------------------------------------------------------
# Python - bytecode y caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
*.so
*.dylib

# Cython / extensiones compiladas
*.egg
*.egg-info/
*.manifest
*.spec

# Distribucion / empaquetado
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt
.installed.cfg
MANIFEST


# -----------------------------------------------------------------------------
# Entornos de desarrollo (IDE / editores)
# -----------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Cursor (opcional; descomenta si no quieres versionar reglas locales)
# .cursor/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock


# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# -----------------------------------------------------------------------------
# Archivos temporales
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.cache
.cache/
tmp/
temp/
~$*


# -----------------------------------------------------------------------------
# Sistema operativo
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*


# -----------------------------------------------------------------------------
# Testing, coverage y calidad de codigo
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
nosetests.xml
pytestdebug.log


# -----------------------------------------------------------------------------
# Type checkers y linters (caches locales)
# -----------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/


# -----------------------------------------------------------------------------
# Jupyter Notebook
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py


# -----------------------------------------------------------------------------
# Neo4j (instancia local / datos en disco)
# -----------------------------------------------------------------------------
# AuraDB no requiere archivos locales; ignorar si usas Neo4j Desktop o Docker
data/
databases/
transactions/
plugins/
import/
certificates/
neo4j.conf.local


# -----------------------------------------------------------------------------
# Docker (si se usa Neo4j en contenedor)
# -----------------------------------------------------------------------------
docker-compose.override.yml
.docker/


# -----------------------------------------------------------------------------
